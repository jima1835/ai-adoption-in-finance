# --- Secrets ---
.env
.env.*
!.env.example

# --- Local working area (gitignored by design — see README "Project structure") ---
# local/ is a nested private repo, so nothing inside it can be tracked here. The
# review tool and the agreement builder are PUBLIC in tools/ (review.py, review.html,
# build_agreement.py); local/review.py, local/review.html and local/build_agreement.py
# are symlinks to them. Everything else under local/ stays private.
local/
CLAUDE.local.md
data/*.bak
data/.institutions.lock
data/.roles.lock
data/*.jsonl.bak

# --- Claude Code local state ---
.claude/settings.local.json
.claude/.cc-writes/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.eggs/

# uv / virtualenvs (uv.lock IS committed)
.venv/
venv/
.python-version

# Test & type-check caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# --- Node / Vite ---
node_modules/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

