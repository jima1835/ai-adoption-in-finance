{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jima1835/ai-adoption-in-finance/schemas/rereads.schema.json",
  "title": "Re-read pass",
  "description": "One record per re-read pass (data/rereads.jsonl): a review of rows already reviewed, against the evidence already on them. Human-gated — the reviewer files it; agents never write it. Stage moves recorded here are corrections, never transitions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "date", "scope", "scope_basis", "n_in_scope", "in_scope", "rule", "direction_checked", "evidence", "initiated_by", "cards_drafted_by", "entries"],
  "properties": {
    "id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "scope": { "type": "string", "minLength": 1 },
    "scope_basis": { "type": "string", "minLength": 1 },
    "n_in_scope": { "type": "integer" },
    "in_scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "rule": { "type": "string", "minLength": 1 },
    "direction_checked": { "type": "string", "enum": ["down", "up", "both"] },
    "evidence": { "type": "string", "minLength": 1 },
    "initiated_by": { "type": "string", "enum": ["reviewer"] },
    "cards_drafted_by": { "type": "string", "enum": ["research agent", "reviewer"] },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["institution", "card_proposed_stage", "decision", "stage_before", "stage_after"],
        "properties": {
          "institution": { "type": "string", "minLength": 1 },
          "card_proposed_stage": { "type": "string", "enum": ["exploring", "piloting", "scaling", "embedded"] },
          "decision": { "type": "string", "enum": ["approved", "rejected"] },
          "stage_before": { "type": "string", "enum": ["exploring", "piloting", "scaling", "embedded"] },
          "stage_after": { "type": "string", "enum": ["exploring", "piloting", "scaling", "embedded"] }
        }
      }
    }
  }
}
